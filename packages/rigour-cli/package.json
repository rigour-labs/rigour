{
    "name": "@rigour-labs/cli",
    "version": "1.0.0",
    "description": "Code review that happens while your agent writes: deterministic checks on the lines it changed, quiet unless it can prove a defect, and learning from your team's fixes and dismissals. Works with Claude Code, Cursor, Codex, Cline and Windsurf.",
    "engines": {
        "node": ">=22.13"
    },
    "license": "MIT",
    "homepage": "https://rigour.run",
    "keywords": [
        "ai",
        "llm",
        "ai-code-quality",
        "ai-agent",
        "quality-gates",
        "cli",
        "linter",
        "static-analysis",
        "security",
        "vibe-coding",
        "claude",
        "cursor",
        "copilot",
        "cline",
        "windsurf",
        "mcp",
        "code-review",
        "ci-cd",
        "fix-packets",
        "agent-governance"
    ],
    "type": "module",
    "bin": {
        "rigour": "dist/bin.js"
    },
    "files": [
        "dist",
        "studio-dist",
        "templates",
        "!dist/**/*.test.js",
        "!dist/**/*.test.d.ts",
        "!dist/**/*.test.js.map"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/rigour-labs/rigour"
    },
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "scripts": {
        "build": "tsc && pnpm bundle-studio",
        "bundle-studio": "node scripts/bundle-studio.js",
        "test": "vitest run"
    },
    "dependencies": {
        "@rigour-labs/core": "workspace:*",
        "chalk": "^5.3.0",
        "commander": "^12.0.0",
        "cosmiconfig": "^9.0.0",
        "execa": "^8.0.1",
        "fs-extra": "^11.4.0",
        "globby": "^14.0.1",
        "inquirer": "9.2.16",
        "ora": "^8.0.1",
        "yaml": "^2.8.2"
    },
    "devDependencies": {
        "@rigour-labs/studio": "workspace:*",
        "@types/fs-extra": "^11.0.4",
        "@types/inquirer": "9.0.7",
        "@types/node": "^25.0.3"
    }
}
