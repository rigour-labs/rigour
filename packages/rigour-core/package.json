{
    "name": "@rigour-labs/core",
    "version": "1.0.0",
    "description": "Rigour's review engine: deterministic gates on changed lines, rules and lessons learned from your team's fixes, and per-check precision from what you fix versus dismiss, across TypeScript, JavaScript, Python, Go, Ruby and C#.",
    "engines": {
        "node": ">=22.13"
    },
    "license": "MIT",
    "homepage": "https://rigour.run",
    "keywords": [
        "ai",
        "llm",
        "ai-code-quality",
        "quality-gates",
        "static-analysis",
        "ast",
        "drift-detection",
        "code-review",
        "linter",
        "machine-learning",
        "bayesian-learning",
        "fix-packets",
        "agent-governance",
        "vibe-coding",
        "security",
        "typescript",
        "python",
        "golang"
    ],
    "type": "module",
    "files": [
        "dist",
        "README.md",
        "!dist/**/*.test.js",
        "!dist/**/*.test.d.ts",
        "!dist/**/*.test.js.map",
        "!dist/**/*.test-support.*"
    ],
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./pattern-index": {
            "types": "./dist/pattern-index/index.d.ts",
            "import": "./dist/pattern-index/index.js"
        },
        "./profile": {
          "types": "./dist/utils/profile.d.ts",
          "import": "./dist/utils/profile.js"
        }
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/rigour-labs/rigour"
    },
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "scripts": {
        "build": "tsc",
        "test": "vitest run"
    },
    "dependencies": {
        "chalk": "^5.6.2",
        "execa": "^8.0.1",
        "fs-extra": "^11.4.0",
        "globby": "^14.1.0",
        "micromatch": "^4.0.8",
        "semver": "^7.7.3",
        "typescript": "^5.9.3",
        "web-tree-sitter": "^0.26.3",
        "yaml": "^2.3.4",
        "zod": "^3.22.4"
    },
    "optionalDependencies": {
        "@rigour-labs/brain-darwin-arm64": "workspace:*",
        "@rigour-labs/brain-darwin-x64": "workspace:*",
        "@rigour-labs/brain-linux-arm64": "workspace:*",
        "@rigour-labs/brain-linux-x64": "workspace:*",
        "@rigour-labs/brain-win-x64": "workspace:*",
        "@anthropic-ai/sdk": "^0.132.1",
        "pg": "^8.16.3",
        "openai": "^5.23.2"
    },
    "devDependencies": {
        "@types/fs-extra": "^11.0.4",
        "@types/micromatch": "^4.0.10",
        "@types/node": "^25.0.3",
        "@types/pg": "^8.15.5",
        "@types/semver": "^7.7.1"
    }
}
